#!/bin/sh
# Antes de cada commit: actualiza la versión de css, js e imágenes en todas las páginas (ver herramientas/versionar.py).
cd "$(git rev-parse --show-toplevel)" || exit 1
# El repositorio es público: si lo que se va a subir parece una clave, una contraseña o una llave privada, no se sube.
# (Revisión de seguridad del 25-nov.) Si es un falso positivo, revisarlo y hacer el commit con --no-verify.
claves='(AIza[0-9A-Za-z_-]{35}|AKIA[0-9A-Z]{16}|gh[pousr]_[0-9A-Za-z]{36}|github_pat_[0-9A-Za-z_]{40,}|sk_live_[0-9A-Za-z]{20,}|rk_live_[0-9A-Za-z]{20,}|sk-ant-[0-9A-Za-z_-]{20,}|sk-(proj-)?[0-9A-Za-z_-]{32,}|tvly-[0-9A-Za-z_-]{20,}|fc-[0-9a-f]{32}|(pk|sk)1_[0-9a-f]{40,}|xox[baprs]-[0-9A-Za-z-]{10,}|hooks\.slack\.com/services/|discord(app)?\.com/api/webhooks/|-----BEGIN [A-Z ]*PRIVATE KEY-----|"private_key":)'
if git diff --cached -U0 --no-color -- . ':!herramientas/hooks/pre-commit' | grep '^+' | grep -v '^+++' | grep -Eq "$claves"; then
  echo "pre-commit: el cambio parece contener una clave o credencial; no se sube (el repositorio es público)."
  git diff --cached -U0 --no-color -- . ':!herramientas/hooks/pre-commit' | grep '^+' | grep -v '^+++' | grep -Eo "$claves" | cut -c1-8 | sed 's/$/... (revisar)/'
  exit 1
fi
# Primero el cierre del pie (firma, Descargar, copyright e idioma) en todas las páginas (ver herramientas/pie_firma.py).
firmas=$(python -I herramientas/pie_firma.py) || { echo "pie_firma.py falló"; exit 1; }
printf '%s\n' "$firmas" | tr -d '\r' | while read -r f; do [ -n "$f" ] && git add -- "$f"; done
# Script del idioma recordado en el <head> de cada página con gemelas (ver herramientas/idioma_guardado.py).
guardado=$(python -I herramientas/idioma_guardado.py) || { echo "idioma_guardado.py falló"; exit 1; }
printf '%s\n' "$guardado" | tr -d '\r' | while read -r f; do [ -n "$f" ] && git add -- "$f"; done
cambiadas=$(python -I herramientas/versionar.py) || { echo "versionar.py falló"; exit 1; }
# Python en Windows termina las líneas con \r\n: se quita el \r para que git encuentre los archivos.
printf '%s\n' "$cambiadas" | tr -d '\r' | while read -r f; do [ -n "$f" ] && git add -- "$f"; done
# La CSP de Cloudflare permite los scripts en línea por su hash: si uno cambió, no se publica hasta actualizar la regla.
python -I herramientas/csp.py --verificar || exit 1
# Las apps (desde la 1.2.6) solo aplican la configuración firmada: si config.json cambió y no se volvió a firmar, no se publica.
if command -v node >/dev/null 2>&1; then
  node herramientas/verificar_config.mjs || exit 1
else
  echo "pre-commit: falta Node; no se pudo comprobar la firma de app/config.firmado.json"
fi
exit 0
